    "/v1/internal/submit": {
      "post": {
        "tags": [
          "email8-mta"
        ],
        "summary": "`POST /v1/internal/submit` — the JMAP/Store submit path.",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token verification failed"
          },
          "403": {
            "description": "Missing email8:submission:send scope or env mismatch"
          },
          "404": {
            "description": "Blob not found in Storage"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitRequest": {
        "type": "object",
        "required": [
          "env_id",
          "account_id",
          "user_sub",
          "return_path",
          "recipients",
          "blob_hash",
          "size",
          "source"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "blob_hash": {
            "type": "string"
          },
          "env_id": {
            "type": "string",
            "format": "uuid"
          },
          "hold_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Delayed send (`sendAt`)."
          },
          "idempotency_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "return_path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "user_sub": {
            "type": "string",
            "format": "uuid",
            "description": "Sentin8:Auth user `sub` — re-verified by Mta from claims."
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": [
          "queue_id"
        ],
        "properties": {
          "next_event_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Earliest due event (retry/notify/expiry) — informational."
          },
          "queue_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
